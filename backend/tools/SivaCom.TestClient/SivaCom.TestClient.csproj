<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SivaComTest.exe: a stand-in consuming application for testing a SivaCom
    server end to end (signed requests, WhatsApp OTP, welcome message). No
    dependency on the API or Data projects, so it shows exactly what an
    application has to implement. Built into its own zip by deploy/New-Release.ps1.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>SivaComTest</AssemblyName>
    <RootNamespace>SivaCom.TestClient</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="sivacom-test.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
