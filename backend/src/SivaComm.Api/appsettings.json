{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "//": "Password is empty on purpose: this file is committed. Use appsettings.Local.json or Database__Password.",
    "Host": "localhost",
    "Port": 5432,
    "Name": "sivacomm",
    "Username": "sivacomm",
    "Password": "",
    "SslMode": "Prefer",
    "MaxPoolSize": 30,
    "CommandTimeoutSeconds": 15
  },

  "Security": {
    "//": "32+ random bytes, base64. Required outside Development. Never in this file. See docs/DEPLOYMENT.md.",
    "MasterKey": "",
    "ClockSkewSeconds": 300
  },

  "Otp": {
    "Length": 6,
    "ExpiryMinutes": 10,
    "MaxAttempts": 5,
    "MaxSendsPerWindow": 3,
    "SendWindowMinutes": 15,
    "ResendCooldownSeconds": 60,
    "GrantExpiryMinutes": 10
  },

  "Messaging": {
    "DefaultCountryCode": "91"
  },

  "Worker": {
    "Enabled": true,
    "BatchSize": 10,
    "MaxConcurrency": 4,
    "MaxAttempts": 5,
    "PollIntervalMilliseconds": 1000,
    "BaseBackoffSeconds": 5,
    "MaxBackoffSeconds": 300,
    "ProviderTimeoutSeconds": 10,
    "RecipientRetentionDays": 30,
    "RecordRetentionDays": 180
  },

  "RateLimits": {
    "CreatePerMinute": 60,
    "VerifyPerMinute": 300
  },

  "WhatsApp": {
    "//": "Empty = messages are logged, not sent. Fill AccessToken and PhoneNumberId (in appsettings.Production.json) to send.",
    "AccessToken": "",
    "PhoneNumberId": "",
    "AppSecret": "",
    "WebhookVerifyToken": "",
    "ApiVersion": "v21.0"
  },

  "Admin": {
    "//": "Bootstrap only: creates the first dashboard admin when none exists. Set in appsettings.Local.json / Production.json.",
    "Username": "",
    "Password": ""
  }
}
