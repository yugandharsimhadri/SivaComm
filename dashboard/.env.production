# Baked into the bundle at build time by Vite — not read at runtime, so
# changing it means rebuilding and re-uploading the dashboard.
#
# Committed because it is not a secret: it is the public hostname of the API,
# visible in every request the dashboard makes. A Cloudflare Pages environment
# variable of the same name overrides it, for a staging build.
#
# The API must list the dashboard's own origin in Cors:AllowedOrigins
# (https://sivacom.sivayaantechnologies.com) or every call is refused.
VITE_API_URL=https://sivacomapi.sivayaantechnologies.com
